{
  "extends": ["config:base", ":timezone(Asia/Tokyo)"],
  "schedule": ["every weekend"],
  "dependencyDashboard": true,
  "pin": {
    "automerge": true
  },
  "npm": {
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["every weekend"]
  }
}
